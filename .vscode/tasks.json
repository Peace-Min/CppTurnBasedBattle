{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Debug",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\vscode-cmake.ps1", "configure"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Debug",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\vscode-cmake.ps1", "build"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "CMake: Configure Debug",
            "problemMatcher": "$msCompile",
            "group": {"kind": "build", "isDefault": true}
        },
        {
            "label": "CMake: Test Debug",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\vscode-cmake.ps1", "test"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "CMake: Build Debug",
            "problemMatcher": []
        },
        {
            "label": "CMake: Run BattleApp",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\vscode-cmake.ps1", "run"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "CMake: Build Debug",
            "problemMatcher": []
        }
    ]
}
